{
  "manifest_version": 3,
  "name": "Whatnot Pokemon Card Price Checker",
  "version": "3.2.0",
  "description": "Scan the Pokémon card on a Whatnot live stream and see its TCGPlayer and Cardmarket market price. Works without an API key.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.pokemontcg.io/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
