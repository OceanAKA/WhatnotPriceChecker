{
  "manifest_version": 3,
  "name": "Card Price Checker for Whatnot",
  "version": "3.2.5",
  "description": "Scan the Pokémon card on a Whatnot stream and see its TCGplayer price, incl. Japanese cards and graded slabs. No API key needed.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://tcgcsv.com/*",
    "https://api.pokemontcg.io/*",
    "https://www.pokemonpricetracker.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
